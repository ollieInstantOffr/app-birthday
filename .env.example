# Database
DB_PASSWORD=bytt-meg
DATABASE_URL=postgresql://birthday:bytt-meg@localhost:5432/birthday

# Innlogging — fødselsdatoen hennes (DDMMÅÅ) bryter seglet
ACCESS_CODE=180994
# Passord til /admin (testmodus, nullstilling, fremdrift og bilder)
ADMIN_PASSWORD=bytt-meg
SESSION_SECRET=bytt-til-en-lang-tilfeldig-streng

# Dagen. Sett til dagens dato for å øve på hele løpet (tidslåsene følger denne datoen).
EVENT_DATE=2026-09-18

# Bildelagring. Er S3_BUCKET tom, lagres bildene lokalt i UPLOAD_DIR.

UPLOAD_DIR=./uploads

TZ=Europe/Oslo

# Porten appen kjører på (host og container)
APP_PORT=7661

# Push-varsler. Generer nøklene én gang med: npx web-push generate-vapid-keys
# Bruk de samme nøklene på serveren — nye nøkler gjør at alle må slå på varsler på nytt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:din@epost.no
